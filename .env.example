# このファイルは git 管理対象。値は書かず、変数名だけを列挙する。
# 実際の値は .env（git管理外）に書く。
#
# 使い方: このファイルをコピーして .env を作り、値を埋める。
#   cp .env.example .env

# ---- Phase 0: foundation ----
# Neon (PostgreSQL)
# Pooled connection（ホスト名に -pooler を含むほう）。アプリから使う
DATABASE_URL=
# Direct connection（-pooler を含まないほう）。Prisma migrate が使う
DIRECT_URL=

# ---- Phase 1: user-auth ----
# Auth.js のセッション署名鍵。`npx auth secret` で生成する
AUTH_SECRET=
# Google Cloud Console で発行した OAuth クライアント
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ---- Phase 2: recipe-analysis ----
# Anthropic Console で発行した API キー
ANTHROPIC_API_KEY=

# AWS S3（アプリ専用の IAM ユーザーのキー。ルートアカウントのキーは使わない）
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-northeast-1
S3_BUCKET_NAME=
