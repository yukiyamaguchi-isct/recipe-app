// Prisma 7 では generator provider が `prisma-client`（`prisma-client-js` は非推奨）で、
// `output` の指定が必須。生成物は node_modules ではなくこのパスに出る。
// import は `@prisma/client` ではなく生成先から行う。

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

// Prisma 7 では url / directUrl をスキーマに書けない。
// マイグレーション用の接続は prisma.config.ts、実行時の接続は lib/prisma.ts のアダプタで指定する。
datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  // Auth.js は初回ログイン時に createUser({ ...profile, emailVerified: null }) を呼ぶ。
  // アダプタは undefined しか除去しないため null がそのまま create に渡り、
  // このフィールドが無いと初回ログインで落ちる。アプリのロジックでは参照しない。
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  accounts      Account[]
  recipes       Recipe[]
}

// Auth.js（Prisma アダプタ）が要求するモデル。
// フィールド名の snake_case は OAuth のレスポンスのキー名そのままで、
// アダプタが値をこの名前で渡してくる。リネームすると linkAccount が実行時に落ちる。
// session strategy が jwt のため Session / VerificationToken は使わない（作らない）。
model Account {
  userId            String
  type              String // "oidc"（Google は OIDC プロバイダ）
  provider          String // "google"
  providerAccountId String // Google が振る不変のID。メールアドレスと違い変わらない
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // アダプタが where: { provider_providerAccountId } で引くため、この組み合わせの一意制約が要る
  @@id([provider, providerAccountId])
  @@index([userId])
}

model Recipe {
  id          String       @id @default(cuid())
  userId      String
  title       String
  imageUrl    String
  // 何人分か。デザインの「材料（4人分）」の見出しに使う。
  // 数値で持つ（2026-08-16 ユーザー決定）。「2〜3人分」のような幅のある表記や
  // 人数が書かれていないレシピは null にして、見出しから人数を省く。
  servings    Int?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingredients Ingredient[]
  steps       Step[]

  @@index([userId])
}

model Ingredient {
  id       String   @id @default(cuid())
  recipeId String
  name     String // 例: 玉ねぎ
  amount   String? // 例: 200g。数値と単位に分けない（「少々」「適量」などがあるため）
  category Category
  order    Int
  recipe   Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([recipeId])
}

model Step {
  id       String @id @default(cuid())
  recipeId String
  order    Int
  text     String
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([recipeId])
}

enum Category {
  SEASONING // 調味料
  VEGETABLE // 野菜
  OTHER // その他
}
